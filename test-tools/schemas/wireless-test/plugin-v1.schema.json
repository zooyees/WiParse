{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wiparse:wireless-plugin:1",
  "title": "Wireless validation plugin S1 development records",
  "description": "Additive PL records. Existing automation-v1 event/measurement/check contracts remain unchanged. G0 pending.",
  "$defs": {
    "version": {"const":"wiparse.wireless-plugin/1"},
    "id": {"type":"string","minLength":1},
    "verdict": {"enum":["PASS","FAIL","INCONCLUSIVE","SKIP"]},
    "trace": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}},
    "caseSpec": {
      "type":"object",
      "required":["id","goal","sys","sw","pl","dg","roles","required_capabilities","risk","initial_state","deadline_ms","steps","capture_plan","checks","cleanup","recovery"],
      "properties": {
        "id":{"$ref":"#/$defs/id"},"goal":{"$ref":"#/$defs/id"},
        "sys":{"$ref":"#/$defs/trace"},"sw":{"$ref":"#/$defs/trace"},"pl":{"$ref":"#/$defs/trace"},"dg":{"$ref":"#/$defs/trace"},
        "roles":{"$ref":"#/$defs/trace"},"required_capabilities":{"$ref":"#/$defs/trace"},
        "risk":{"$ref":"#/$defs/id"},"initial_state":{"$ref":"#/$defs/id"},
        "deadline_ms":{"type":"integer","minimum":1,"maximum":3600000},
        "steps":{"type":"array","minItems":1,"items":{"type":"object","required":["id","condition","deadline_ms"]}},
        "capture_plan":{"type":"object"},"checks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/checkSpec"}},
        "cleanup":{"$ref":"#/$defs/id"},"recovery":{"$ref":"#/$defs/id"}
      }
    },
    "checkSpec": {
      "type":"object","required":["id","kind","required"],
      "properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["scalar","state","communication"]},"required":{"const":true},"metric_id":{"$ref":"#/$defs/id"},"limits_ref":{"$ref":"#/$defs/id"}}
    },
    "run": {
      "type":"object",
      "required":["schema_version","run_id","attempt_id","project","test_id","configuration_hashes","mode","execution_status","product_verdict","validation_verdict","industrial_approved","cases","errors"],
      "properties": {
        "schema_version":{"$ref":"#/$defs/version"},"run_id":{"$ref":"#/$defs/id"},"attempt_id":{"$ref":"#/$defs/id"},"project":{"$ref":"#/$defs/id"},"test_id":{"$ref":"#/$defs/id"},
        "mode":{"enum":["dry-run","replay","live"]},"configuration_hashes":{"type":"object"},
        "execution_status":{"enum":["completed","error","cancelled","interrupted"]},
        "product_verdict":{"$ref":"#/$defs/verdict"},"validation_verdict":{"$ref":"#/$defs/verdict"},"industrial_approved":{"const":false},
        "cases":{"type":"array"},"errors":{"type":"array"}
      }
    }
  }
}
