{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiparse.local/schemas/plugin.schema.json",
  "title": "WiParse Test Plugin Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "type",
    "report_name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "name_zh": {
      "type": "string"
    },
    "report_name": {
      "type": "string",
      "minLength": 1,
      "description": "Test Report sidebar title and default tests/{test_id}/ plus file_prefix. Not a run stamp."
    },
    "report_name_zh": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "smoke",
        "serial",
        "instrument",
        "capture_loop",
        "custom"
      ]
    },
    "version": {
      "type": "string"
    },
    "entry": {
      "type": "string"
    },
    "config": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "configure",
          "preflight",
          "run",
          "stop"
        ]
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string"
        },
        "wiparse": {
          "type": "string"
        }
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "path",
              "device",
              "enum",
              "serial_port",
              "json",
              "text"
            ]
          },
          "default": {},
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "label_zh": {
            "type": "string"
          },
          "help": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "group": {
            "type": "string"
          },
          "group_zh": {
            "type": "string"
          },
          "advanced": {
            "type": "boolean"
          },
          "filter": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              }
            }
          },
          "filter_from": {
            "type": "string"
          },
          "fills": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "options": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "label_zh": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "publisher": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "stable",
            "beta",
            "internal"
          ]
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "gui.api",
              "cli",
              "serial",
              "fs.data_root",
              "fs.plugin_dir",
              "network.outbound"
            ]
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "label": {
            "type": "string"
          },
          "label_zh": {
            "type": "string"
          },
          "view": {
            "type": "string",
            "enum": [
              "wave",
              "log",
              "report",
              "external"
            ]
          },
          "dir": {
            "type": "string"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "always": {
            "type": "boolean"
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "required": [
        "mode",
        "max_items",
        "matrix_status_file",
        "config_editor"
      ],
      "properties": {
        "mode": {
          "const": "test_matrix"
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "matrix_status_file": {
          "type": "string"
        },
        "config_editor": {
          "type": "object",
          "required": [
            "schema",
            "repository"
          ],
          "properties": {
            "schema": {
              "type": "string"
            },
            "ui_schema": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "source_view": {
              "enum": [
                "hidden",
                "read_only"
              ]
            }
          }
        },
        "execution_controls": {
          "type": "object",
          "required": [
            "control_file",
            "pause_mode"
          ],
          "additionalProperties": false,
          "properties": {
            "control_file": {
              "type": "string"
            },
            "pause_mode": {
              "const": "between_items"
            }
          }
        }
      }
    }
  }
}
