{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiparse.local/schemas/plugin.schema.json",
  "title": "WiParse Test Plugin Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "type"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "name_zh": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["smoke", "serial", "instrument", "capture_loop", "custom"]
    },
    "version": { "type": "string" },
    "entry": { "type": "string" },
    "config": { "type": "string" },
    "description": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "enum": ["preflight", "run", "stop"] }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string" },
        "wiparse": { "type": "string" }
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["string", "number", "boolean", "path", "device", "enum", "serial_port", "json", "text"] },
          "default": {},
          "path": { "type": "string" },
          "label": { "type": "string" },
          "label_zh": { "type": "string" },
          "help": { "type": "string" },
          "hidden": { "type": "boolean" },
          "group": { "type": "string" },
          "group_zh": { "type": "string" },
          "advanced": { "type": "boolean" },
          "filter": {
            "type": "object",
            "properties": {
              "kind": { "type": "string" }
            }
          },
          "filter_from": { "type": "string" },
          "fills": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "options": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["value"],
                  "properties": {
                    "value": { "type": "string" },
                    "label": { "type": "string" },
                    "label_zh": { "type": "string" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "publisher": { "type": "string" },
    "license": { "type": "string" },
    "repository": { "type": "string" },
    "marketplace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["stable", "beta", "internal"]
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "gui.api",
              "cli",
              "serial",
              "fs.data_root",
              "fs.plugin_dir",
              "network.outbound"
            ]
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "label": { "type": "string" },
          "label_zh": { "type": "string" },
          "view": {
            "type": "string",
            "enum": ["wave", "log", "report", "external"]
          },
          "dir": { "type": "string" },
          "include": {
            "type": "array",
            "items": { "type": "string" }
          },
          "always": { "type": "boolean" }
        }
      }
    }
  }
}
