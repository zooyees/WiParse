{
  "id": "scope-serial-monitor",
  "name": "Scope & Serial Monitor",
  "name_zh": "示波器/串口监控",
  "type": "capture_loop",
  "version": "0.3.0",
  "entry": "index.mjs",
  "config": "station.json",
  "description": "Serial rising-edge → scope stop → shot/ISF/PDF → resume. Instrument identity is a Hub param; Preflight auto-fills the connected device.",
  "capabilities": ["preflight", "run", "stop"],
  "engines": {
    "node": ">=18",
    "wiparse": ">=1.1.10"
  },
  "params": [
    {
      "name": "file_prefix",
      "type": "string",
      "path": "paths.file_prefix",
      "default": "ScopeSerial",
      "label": "Report name / prefix",
      "label_zh": "报告名称/前缀",
      "help": "Prefix for ISF, PDF, PNG, and the summary Markdown (e.g. MyLot → MyLot_summary_*.md)"
    },
    {
      "name": "prefer_device_id",
      "type": "device",
      "path": "scope.prefer_device_id",
      "filter": { "kind": "oscilloscope" },
      "filter_from": "scope_kind",
      "fills": {
        "scope_resource": "resource",
        "scope_model": "model",
        "scope_kind": "kind"
      },
      "default": "",
      "label": "Instrument",
      "label_zh": "仪器",
      "help": "Pick a connected instrument, or leave Auto and click Preflight to fill from the live list."
    },
    {
      "name": "scope_kind",
      "type": "enum",
      "path": "scope.kind",
      "default": "oscilloscope",
      "label": "Instrument kind",
      "label_zh": "仪器类型",
      "help": "Filters the instrument picker. Changing kind does not require Hub code changes.",
      "options": [
        { "value": "oscilloscope", "label": "Oscilloscope", "label_zh": "示波器" },
        { "value": "dc_source", "label": "DC source", "label_zh": "直流电源" },
        { "value": "electronic_load", "label": "Electronic load", "label_zh": "电子负载" },
        { "value": "multimeter", "label": "Multimeter", "label_zh": "万用表" },
        { "value": "generic", "label": "Generic SCPI", "label_zh": "通用 SCPI" }
      ]
    },
    {
      "name": "scope_model",
      "type": "string",
      "path": "scope.model",
      "default": "",
      "label": "Model",
      "label_zh": "型号",
      "help": "Optional. Empty = accept any model of this kind. Preflight fills from *IDN?."
    },
    {
      "name": "scope_resource",
      "type": "string",
      "path": "scope.resource",
      "default": "",
      "label": "VISA resource",
      "label_zh": "VISA 资源",
      "help": "Optional. Empty = use the connected device. Used to reconnect if the session dropped."
    },
    {
      "name": "isf_dir",
      "type": "path",
      "path": "paths.isf_dir",
      "default": "{data_root}/instrument_data/{product}",
      "label": "ISF directory",
      "label_zh": "波形源文件目录",
      "help": "Where .isf waveform sources are saved"
    },
    {
      "name": "report_dir",
      "type": "path",
      "path": "paths.report_dir",
      "default": "{data_root}/test report/{product}",
      "label": "Report directory",
      "label_zh": "报告保存目录",
      "help": "PDF / HTML / summary MD directory"
    },
    {
      "name": "product",
      "type": "string",
      "path": "station.product",
      "default": "ScopeSerial",
      "label": "Product",
      "label_zh": "产品名",
      "help": "Used in path templates as {product}"
    },
    {
      "name": "port",
      "type": "serial_port",
      "path": "serial.port",
      "default": "COM7",
      "label": "Serial port",
      "label_zh": "串口",
      "help": "COM port for live monitor"
    },
    {
      "name": "baud",
      "type": "number",
      "path": "serial.baud",
      "default": "2000000",
      "label": "Baud",
      "label_zh": "波特率"
    },
    {
      "name": "api",
      "type": "string",
      "path": "gui.api",
      "default": "http://127.0.0.1:7878",
      "label": "GUI API",
      "label_zh": "GUI API 地址"
    },
    {
      "name": "preflight_only",
      "type": "boolean",
      "default": "false",
      "label": "Preflight only",
      "label_zh": "仅预检",
      "help": "Run checks and exit without starting the loop"
    }
  ]
}
