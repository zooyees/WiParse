            },
            "type": {
              "const": "log_match_count",
              "title": "type",
              "x-title-zh": "类型"
            },
            "required": {
              "type": "boolean",
              "default": true,
              "title": "required",
              "x-title-zh": "必需"
            },
            "evidence_refs": {
              "type": "array",
