{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "wiparse.fpga-test-case/2",
      "title": "schema version"
    },
    "editor_revision": {
      "type": "integer",
      "minimum": 0,
      "readOnly": true,
      "title": "editor revision",
      "x-title-zh": "编辑版本"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "title": "updated at",
      "x-title-zh": "更新时间"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "id",
      "x-title-zh": "标识"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "default": "新测试项",
      "title": "name",
      "x-title-zh": "名称"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "title": "enabled",
      "x-title-zh": "启用"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "title": "order",
      "x-title-zh": "排序"
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "uniqueItems": true,
      "title": "tags",
      "x-title-zh": "标签"
    },
    "timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 120,
      "title": "timeout s",
      "x-title-zh": "超时",
      "x-unit": "s"
    },
    "firmware": {
      "type": "object",
      "properties": {
        "download": {
          "type": "boolean",
          "description": "接口预留；true 阻断预检",
          "default": false,
          "title": "download",
          "x-title-zh": "下载（接口预留）"
        },
        "implementation": {
          "const": "reserved",
          "title": "implementation"
        },
        "path": {
          "type": "string",
          "format": "file-path",
          "x-path-base": "config_dir",
          "title": "path",
          "x-title-zh": "文件"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "readOnly": true,
          "description": "Generated by explicit file inspection; preflight independently verifies the actual file hash.",
          "x-description-zh": "由文件检查生成；预检仍会独立复核实际文件哈希。",
          "title": "sha256",
          "x-title-zh": "SHA-256"
        },
        "target": {
          "type": "string",
          "title": "target",
          "x-title-zh": "目标芯片"
        },
        "format": {
          "enum": [
            "hex",
            "bin"
          ],
          "title": "format",
          "x-title-zh": "格式"
        },
        "base_address": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "title": "base address",
          "x-title-zh": "基地址"
        },
        "verify": {
          "type": "boolean",
          "title": "verify"
        }
      },
      "required": [
        "download",
        "path",
        "sha256",
        "target",
        "format"
      ],
      "additionalProperties": false,
      "title": "firmware",
      "x-title-zh": "固件"
    },
    "reset": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "dc_power",
              "title": "method",
              "x-title-zh": "方式"
            },
            "power_role": {
              "type": "string",
              "title": "power role",
              "x-title-zh": "电源角色"
            },
            "channel": {
              "type": "integer",
              "minimum": 1,
              "title": "channel",
              "x-title-zh": "通道"
            },
            "off_time_ms": {
              "type": "number",
              "minimum": 0,
              "title": "off time ms",
              "x-title-zh": "断电时长",
              "x-unit": "ms"
            },
            "release_confirmation": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "voltage_threshold",
                      "title": "type",
                      "x-title-zh": "类型"
                    },
                    "minimum_v": {
                      "type": "number",
                      "minimum": 0,
                      "title": "minimum v"
                    },
                    "stable_ms": {
                      "type": "number",
                      "minimum": 0,
                      "title": "stable ms",
                      "x-unit": "ms"
                    },
                    "timeout_ms": {
                      "type": "number",
                      "minimum": 0,
                      "title": "timeout ms",
                      "x-title-zh": "确认超时",
                      "x-unit": "ms"
                    }
                  },
                  "required": [
                    "type",
                    "minimum_v",
                    "stable_ms",
                    "timeout_ms"
                  ],
                  "additionalProperties": false,
                  "title": "Voltage threshold confirmation",
                  "x-title-zh": "电压阈值确认"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "command_ack",
                        "command_complete"
                      ],
                      "title": "type",
                      "x-title-zh": "类型"
                    },
                    "timeout_ms": {
                      "type": "number",
                      "minimum": 0,
                      "title": "timeout ms",
                      "x-title-zh": "确认超时",
                      "x-unit": "ms"
                    }
                  },
                  "required": [
                    "type",
                    "timeout_ms"
                  ],
                  "additionalProperties": false,
                  "title": "Command acknowledgement confirmation",
                  "x-title-zh": "指令应答确认"
                }
              ],
              "title": "release confirmation",
              "x-title-zh": "复位释放确认"
            }
          },
          "required": [
            "method",
            "power_role",
            "channel",
            "off_time_ms",
            "release_confirmation"
          ],
          "additionalProperties": false,
          "title": "DC power reset",
          "x-title-zh": "直流电源断电复位"
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "wiparse_dongle",
              "title": "method",
              "x-title-zh": "方式"
            },
            "dongle_role": {
              "type": "string",
              "title": "dongle role",
              "x-title-zh": "Dongle 角色"
            },
            "hardware": {
              "const": true,
              "title": "hardware",
              "x-title-zh": "硬件复位"
            },
            "release_confirmation": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "voltage_threshold",
                      "title": "type",
                      "x-title-zh": "类型"
                    },
                    "minimum_v": {
                      "type": "number",
                      "minimum": 0,
                      "title": "minimum v"
                    },
                    "stable_ms": {
                      "type": "number",
                      "minimum": 0,
                      "title": "stable ms",
                      "x-unit": "ms"
                    },
                    "timeout_ms": {
                      "type": "number",
                      "minimum": 0,
                      "title": "timeout ms",
                      "x-title-zh": "确认超时",
                      "x-unit": "ms"
                    }
                  },
                  "required": [
                    "type",
                    "minimum_v",
                    "stable_ms",
                    "timeout_ms"
                  ],
                  "additionalProperties": false,
                  "title": "Voltage threshold confirmation",
                  "x-title-zh": "电压阈值确认"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "command_ack",
                        "command_complete"
                      ],
                      "title": "type",
                      "x-title-zh": "类型"
                    },
                    "timeout_ms": {
                      "type": "number",
                      "minimum": 0,
                      "title": "timeout ms",
                      "x-title-zh": "确认超时",
                      "x-unit": "ms"
                    }
                  },
                  "required": [
                    "type",
                    "timeout_ms"
                  ],
                  "additionalProperties": false,
                  "title": "Command acknowledgement confirmation",
                  "x-title-zh": "指令应答确认"
                }
              ],
              "title": "release confirmation",
              "x-title-zh": "复位释放确认"
            }
          },
          "required": [
            "method",
            "dongle_role",
            "hardware",
            "release_confirmation"
          ],
          "additionalProperties": false,
          "title": "Dongle hardware reset",
          "x-title-zh": "Dongle 硬件复位"
        }
      ],
      "title": "reset",
      "x-title-zh": "复位"
    },
    "timing": {
      "type": "object",
      "properties": {
        "anchor": {
          "const": "after_reset_release",
          "title": "anchor"
        }
      },
      "required": [
        "anchor"
      ],
      "additionalProperties": false,
      "title": "timing",
      "x-title-zh": "计时"
    },
    "log_capture": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "enabled",
          "x-title-zh": "启用"
        },
        "start_at_s": {
          "type": "number",
          "minimum": 0,
          "title": "start at s",
          "x-title-zh": "开始时间",
          "x-unit": "s"
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "title": "duration s",
          "x-title-zh": "持续时间",
          "x-unit": "s"
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "title": "max lines",
          "x-title-zh": "最大行数"
        },
        "encoding": {
          "const": "utf-8",
          "title": "encoding",
          "x-title-zh": "编码"
        },
        "resource_role": {
          "type": "string",
          "minLength": 1,
          "title": "Resource role",
          "x-title-zh": "日志角色"
        }
      },
      "required": [
        "enabled",
        "start_at_s",
        "duration_s",
        "max_lines",
        "encoding"
      ],
      "additionalProperties": false,
      "title": "log capture",
      "x-title-zh": "日志采集",
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "resource_role"
            ]
          }
        }
      ]
    },
    "waveform_captures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "id",
            "x-title-zh": "标识"
          },
          "at_s": {
            "type": "number",
            "minimum": 0,
            "title": "at s",
            "x-title-zh": "采集时点",
            "x-unit": "s"
          },
          "kind": {
            "const": "screenshot",
            "title": "kind",
            "x-title-zh": "设备类型"
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "title": "channels",
            "x-title-zh": "通道列表"
          },
          "source_waveform": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "title": "enabled",
                "x-title-zh": "启用"
              },
              "format": {
                "enum": [
                  "instrument_native",
                  "csv"
                ],
                "title": "format",
                "x-title-zh": "格式"
              }
            },
            "required": [
              "enabled"
            ],
            "additionalProperties": false,
            "title": "source waveform",
            "x-title-zh": "源波形"
          },
          "timeout_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "timeout s",
            "x-title-zh": "超时",
            "x-unit": "s"
          }
        },
        "required": [
          "id",
          "at_s",
          "kind",
          "channels",
          "source_waveform",
          "timeout_s"
        ],
        "additionalProperties": false
      },
      "title": "waveform captures",
      "x-title-zh": "波形任务"
    },
    "verdict": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "all",
          "title": "mode",
          "x-title-zh": "模式"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          },
          "title": "rules",
          "x-title-zh": "规则"
        },
        "ai_assist": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "enabled",
              "x-title-zh": "启用"
            },
            "policy": {
              "const": "advisory_only",
              "title": "policy",
              "x-title-zh": "策略"
            },
            "provider_profile": {
              "type": "string",
              "title": "provider profile",
              "x-title-zh": "服务配置"
            },
            "inputs": {
              "type": "array",
              "items": {
                "enum": [
                  "log",
                  "log_excerpt",
                  "rule_results",
                  "waveform_metrics"
                ]
              },
              "title": "inputs"
            },
            "required": {
              "type": "boolean",
              "title": "required",
              "x-title-zh": "必需"
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0,
              "title": "timeout s",
              "x-title-zh": "超时",
              "x-unit": "s"
            },
            "redaction_profile": {
              "type": "string",
              "title": "redaction profile"
            },
            "prompt_template_id": {
              "type": "string",
              "title": "prompt template id"
            }
          },
          "required": [
            "enabled",
            "policy"
          ],
          "additionalProperties": false,
          "title": "ai assist",
          "x-title-zh": "AI 辅助"
        }
      },
      "required": [
        "mode",
        "rules"
      ],
      "additionalProperties": false,
      "title": "verdict",
      "x-title-zh": "判定"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "enabled",
    "timeout_s",
    "firmware",
    "reset",
    "timing",
    "log_capture",
    "waveform_captures",
    "verdict"
  ],
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "oneOf": [
        {
          "type": "object",
