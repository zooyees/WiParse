            },
            "metric": {
              "enum": [
                "frequency_hz",
                "period_s",
                "duty_cycle",
                "peak_to_peak_v",
                "minimum_v",
                "maximum_v",
                "mean_v",
                "rise_time_s",
                "fall_time_s"
              ],
              "title": "metric",
              "x-title-zh": "指标"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
