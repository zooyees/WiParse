              "x-title-zh": "类型"
            },
            "required": {
              "type": "boolean",
              "default": true,
              "title": "required",
              "x-title-zh": "必需"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "evidence refs"
            },
            "pattern": {
              "type": "string",
              "minLength": 1,
              "title": "pattern",
              "x-title-zh": "正则"
            }
          },
          "required": [
