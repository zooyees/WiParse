{
  "id": "wiparse-netcfg",
  "name": "Dongle Network Config",
  "name_zh": "Dongle 网络配置",
  "report_name": "WiparseNetcfg",
  "report_name_zh": "Dongle 配网",
  "type": "instrument",
  "version": "1.1.0",
  "entry": "index.mjs",
  "config": "station.json",
  "description": "WIPARSE-IF CH-NETCFG (ICD v1.4). Write STA SSID/PSK/IP to NVS and APPLY without flashing. USB MI_05 EP0 vendor 0x20/0x21 (STA down OK), or TCP :1238 after GOT_IP. Firmware bcdDevice 0x0208.",
  "capabilities": ["preflight", "run", "stop"],
  "engines": {
    "node": ">=18",
    "wiparse": ">=1.1.16"
  },
  "sandbox": {
    "permissions": ["gui.api", "cli", "fs.data_root", "network.outbound"]
  },
  "outputs": [
    {
      "id": "logs",
      "label": "NETCFG log",
      "label_zh": "配置日志",
      "view": "log",
      "dir": "{artifacts_dir}/logs",
      "include": ["*.jsonl", "*.json", "*.txt"]
    },
    {
      "id": "reports",
      "label": "Report",
      "label_zh": "报告",
      "view": "report",
      "dir": "{artifacts_dir}/reports",
      "include": ["*.md"]
    }
  ],
  "params": [
    {
      "name": "file_prefix",
      "type": "string",
      "path": "paths.file_prefix",
      "default": "WiparseNetcfg",
      "group": "paths",
      "group_zh": "路径",
      "label": "Report name / prefix",
      "label_zh": "报告名称/前缀",
      "help": "Optional override of plugin.json report_name. Sanitized value is tests/{test_id}/."
    },
    {
      "name": "transport",
      "type": "enum",
      "path": "channel.transport",
      "default": "usb",
      "group": "transport",
      "group_zh": "传输",
      "label": "Transport",
      "label_zh": "传输",
      "help": "usb = WinUSB MI_05 EP0 (works when STA is down). tcp = :1238 after GOT_IP. auto = USB then TCP. APPLY over TCP may drop the socket while Wi-Fi reconnects.",
      "options": [
        { "value": "usb", "label": "USB WinUSB MI_05", "label_zh": "USB（推荐）" },
        { "value": "auto", "label": "Auto USB then TCP", "label_zh": "自动 USB→TCP" },
        { "value": "tcp", "label": "TCP :1238", "label_zh": "TCP" }
      ]
    },
    {
      "name": "host",
      "type": "string",
      "path": "channel.host",
      "default": "dap.local",
      "group": "transport",
      "group_zh": "传输",
      "label": "Host",
      "label_zh": "主机"
    },
    {
      "name": "tcp_port",
      "type": "number",
      "path": "channel.tcp_port",
      "default": 1238,
      "group": "transport",
      "group_zh": "传输",
      "label": "TCP port",
      "label_zh": "TCP 端口"
    },
    {
      "name": "vid",
      "type": "string",
      "path": "channel.vid",
      "default": "C251",
      "group": "transport",
      "group_zh": "传输",
      "advanced": true,
      "label": "USB VID",
      "label_zh": "USB VID"
    },
    {
      "name": "pid",
      "type": "string",
      "path": "channel.pid",
      "default": "F01A",
      "group": "transport",
      "group_zh": "传输",
      "advanced": true,
      "label": "USB PID",
      "label_zh": "USB PID"
    },
    {
      "name": "fallback_host",
      "type": "string",
      "path": "channel.fallback_host",
      "default": "192.168.137.123",
      "group": "transport",
      "group_zh": "传输",
      "advanced": true,
      "label": "Fallback IPv4",
      "label_zh": "备用 IPv4",
      "help": "Tried only when Host is empty or dap.local. Clear to disable."
    },
    {
      "name": "usb_mi",
      "type": "number",
      "path": "channel.usb_mi",
      "default": 5,
      "group": "transport",
      "group_zh": "传输",
      "advanced": true,
      "label": "USB interface MI",
      "label_zh": "USB 接口号"
    },
    {
      "name": "usb_guid",
      "type": "string",
      "path": "channel.usb_guid",
      "default": "{7B3E9C41-2A18-4F6D-9E50-1C8A6D4B0105}",
      "group": "transport",
      "group_zh": "传输",
      "advanced": true,
      "label": "WinUSB GUID",
      "label_zh": "WinUSB GUID"
    },
    {
      "name": "usb_name",
      "type": "string",
      "path": "channel.usb_name",
      "default": "",
      "group": "transport",
      "group_zh": "传输",
      "advanced": true,
      "label": "USB name contains",
      "label_zh": "USB 名称包含"
    },
    {
      "name": "connect_timeout_ms",
      "type": "number",
      "path": "channel.connect_timeout_ms",
      "default": 4000,
      "group": "transport",
      "group_zh": "传输",
      "advanced": true,
      "label": "Connect timeout (ms)",
      "label_zh": "连接超时 ms"
    },
    {
      "name": "op",
      "type": "enum",
      "path": "run.op",
      "default": "apply",
      "group": "action",
      "group_zh": "动作",
      "label": "Operation",
      "label_zh": "操作",
      "options": [
        { "value": "status", "label": "STATUS", "label_zh": "查询" },
        { "value": "apply", "label": "Set + APPLY", "label_zh": "下发并生效" },
        { "value": "save", "label": "Set + SAVE", "label_zh": "仅保存 NVS" },
        { "value": "revert", "label": "REVERT", "label_zh": "恢复固件默认" },
        { "value": "help", "label": "HELP", "label_zh": "帮助" },
        { "value": "discover", "label": "Discover", "label_zh": "发现" },
        { "value": "script", "label": "Script text", "label_zh": "脚本文本" }
      ]
    },
    {
      "name": "ssid",
      "type": "string",
      "path": "wifi.ssid",
      "default": "WINDLINK",
      "group": "wifi",
      "group_zh": "Wi-Fi",
      "label": "SSID",
      "label_zh": "SSID"
    },
    {
      "name": "psk",
      "type": "string",
      "path": "wifi.psk",
      "default": "",
      "group": "wifi",
      "group_zh": "Wi-Fi",
      "label": "Password",
      "label_zh": "密码",
      "help": "WPA PSK, 8–63 bytes. Never logged. Sent as PSK <value>."
    },
    {
      "name": "dhcp",
      "type": "boolean",
      "path": "wifi.dhcp",
      "default": "false",
      "group": "wifi",
      "group_zh": "Wi-Fi",
      "label": "DHCP",
      "label_zh": "DHCP"
    },
    {
      "name": "ip",
      "type": "string",
      "path": "wifi.ip",
      "default": "192.168.137.123",
      "group": "wifi",
      "group_zh": "Wi-Fi",
      "label": "Static IPv4",
      "label_zh": "静态 IPv4"
    },
    {
      "name": "gateway",
      "type": "string",
      "path": "wifi.gateway",
      "default": "192.168.137.1",
      "group": "wifi",
      "group_zh": "Wi-Fi",
      "label": "Gateway",
      "label_zh": "网关"
    },
    {
      "name": "netmask",
      "type": "string",
      "path": "wifi.netmask",
      "default": "255.255.255.0",
      "group": "wifi",
      "group_zh": "Wi-Fi",
      "label": "Netmask",
      "label_zh": "掩码"
    },
    {
      "name": "hostname",
      "type": "string",
      "path": "wifi.hostname",
      "default": "dap",
      "group": "wifi",
      "group_zh": "Wi-Fi",
      "label": "mDNS hostname",
      "label_zh": "mDNS 主机名"
    },
    {
      "name": "script",
      "type": "text",
      "path": "run.script",
      "default": "",
      "group": "script",
      "group_zh": "脚本",
      "label": "Script (one cmd/line)",
      "label_zh": "脚本（一行一条）",
      "help": "Raw ICD lines. Comments start with #. APPLY writes NVS and reconnects; do not flash."
    },
    {
      "name": "wait_got_ip_ms",
      "type": "number",
      "path": "run.wait_got_ip_ms",
      "default": 15000,
      "group": "action",
      "group_zh": "动作",
      "label": "Wait GOT_IP (ms)",
      "label_zh": "等待入网 ms",
      "help": "After APPLY/REVERT, poll STATUS until wifi=1 or this timeout. 0 skips the wait."
    }
  ]
}
