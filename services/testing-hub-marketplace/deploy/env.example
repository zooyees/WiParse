# Copy to /etc/wiparse-marketplace/env (chmod 600).
# systemd EnvironmentFile= for wiparse-marketplace.service

HOST=127.0.0.1
PORT=8787
MARKETPLACE_DATA_DIR=/var/lib/wiparse-marketplace

# Comma-separated Bearer tokens for POST/DELETE. Empty = publish disabled (401).
# Generate: openssl rand -hex 32
MARKETPLACE_PUBLISH_TOKENS=CHANGE_ME_TOKEN
