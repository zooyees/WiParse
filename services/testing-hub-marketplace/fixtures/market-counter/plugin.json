{
  "id": "market-counter",
  "name": "Market Counter",
  "name_zh": "市场计数器",
  "report_name": "MarketCounter",
  "report_name_zh": "市场计数",
  "type": "smoke",
  "version": "1.1.0",
  "entry": "index.mjs",
  "capabilities": [
    "preflight",
    "run"
  ],
  "description": "Counts 1..N and returns a summary (good after-install run).",
  "publisher": "wiparse",
  "marketplace": {
    "channel": "stable"
  },
  "sandbox": {
    "permissions": [
      "gui.api",
      "cli"
    ]
  },
  "engines": {
    "node": ">=18",
    "wiparse": ">=1.1.16"
  },
  "params": [
    {
      "name": "count",
      "type": "number",
      "default": "3",
      "label": "Count",
      "label_zh": "次数",
      "help": "How many steps to count"
    }
  ]
}
