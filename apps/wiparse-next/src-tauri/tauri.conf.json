{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiParse Next",
  "version": "0.1.0",
  "identifier": "com.wiparse.next",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "WiParse", "width": 1440, "height": 900, "minWidth": 1100, "minHeight": 720 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
