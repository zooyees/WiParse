      },
      {
        "id": "no_fatal_errors",
        "type": "log_not_regex",
        "pattern": "\\b(FATAL|ASSERT|PANIC)\\b",
        "required": true
      }
    ],
    "ai_assist": {
      "enabled": false,
      "policy": "advisory_only",
